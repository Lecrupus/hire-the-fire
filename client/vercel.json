{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://hire-the-fire-api.onrender.com/api/:path*" },
    {
      "source": "/uploads/:path*",
      "destination": "https://hire-the-fire-api.onrender.com/uploads/:path*"
    },
    { "source": "/((?!assets/|demo/|favicon).*)", "destination": "/index.html" }
  ]
}
