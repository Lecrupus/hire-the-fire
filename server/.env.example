# Copy to server/.env and fill in. Never commit real values.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/hire-the-fire
CLIENT_URL=http://localhost:5173

# Use long random strings (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh

# Optional: when unset, uploads are stored on local disk under server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: when unset, status-change emails are written to the log instead of sent
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hire the Fire <no-reply@hirethefire.dev>"
